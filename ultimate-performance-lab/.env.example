# ── Datenbank ────────────────────────────────────────────────────────────────
# PostgreSQL / Supabase (Connection-String aus "Project Settings → Database").
# Ohne DATABASE_URL startet die App mit einer eingebetteten Postgres-Instanz
# (PGlite) unter ./.data – ideal für lokale Entwicklung und Gastbetrieb.
DATABASE_URL=

# ── Live-Recherche (alle optional, ausschließlich serverseitig) ──────────────
# Ohne Schlüssel arbeiten nur die kostenlosen Quellen (lokaler Katalog,
# kuratierte Recherche, Wikipedia, Wikimedia Commons).
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Eigene SearXNG-Instanz, z. B. https://searx.example.org
SEARXNG_URL=
# Kontaktangabe im User-Agent für Wikimedia-APIs (von Wikimedia empfohlen)
RESEARCH_USER_AGENT_CONTACT=

# ── E-Mail (Passwort zurücksetzen) ───────────────────────────────────────────
# Ohne RESEND_API_KEY wird der Reset-Link in der Entwicklung im Server-Log und
# in der API-Antwort ausgegeben, in Produktion nur protokolliert.
RESEND_API_KEY=
MAIL_FROM=
APP_URL=http://localhost:3000
